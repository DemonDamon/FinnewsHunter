# Author: Damon Li
# This image is an S01 compatibility verification image, not a final minimal production image.

ARG PYTHON_BASE=python:3.11
FROM ${PYTHON_BASE}

ARG FINNEWS_MODE=legacy
WORKDIR /app

COPY backend/requirements.txt /app/requirements.txt
COPY backend/requirements.txt /opt/finnews-deps/requirements.txt
COPY backend/requirements-research.lock /opt/finnews-deps/requirements-research.lock
COPY deploy/celery-entrypoint.sh /usr/local/bin/celery-entrypoint.sh

RUN if [ "$FINNEWS_MODE" = "research" ]; then \
        python -m pip install --no-cache-dir --require-hashes -r /opt/finnews-deps/requirements-research.lock; \
    else \
        python -m pip install --no-cache-dir -r /opt/finnews-deps/requirements.txt; \
    fi \
    && chmod +x /usr/local/bin/celery-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/celery-entrypoint.sh"]
CMD ["celery", "-A", "app.core.celery_app", "worker", "--loglevel=info"]
