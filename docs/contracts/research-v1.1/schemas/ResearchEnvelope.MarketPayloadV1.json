{
  "$defs": {
    "ContractError": {
      "additionalProperties": false,
      "description": "Describe a safe, stable error returned to a contract caller.",
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ContractError",
      "type": "object"
    },
    "MarketFieldV1": {
      "additionalProperties": false,
      "description": "Represent one bounded decimal-valued market observation field.",
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "unit"
      ],
      "title": "MarketFieldV1",
      "type": "object"
    },
    "MarketPayloadV1": {
      "additionalProperties": false,
      "description": "Represent market observations that are linked to registered evidence.",
      "properties": {
        "adjustment": {
          "enum": [
            "none",
            "forward",
            "backward"
          ],
          "title": "Adjustment",
          "type": "string"
        },
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "fetched_at": {
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/MarketFieldV1"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "is_mock": {
          "title": "Is Mock",
          "type": "boolean"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "symbol": {
          "maxLength": 12,
          "minLength": 12,
          "pattern": "^CN\\.(SH|SZ|BJ)\\.[0-9]{6}$",
          "title": "Symbol",
          "type": "string"
        },
        "timezone": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "symbol",
        "observed_at",
        "available_at",
        "fetched_at",
        "timezone",
        "currency",
        "adjustment",
        "fields",
        "provider",
        "version",
        "is_mock"
      ],
      "title": "MarketPayloadV1",
      "type": "object"
    },
    "SourceRefV1": {
      "additionalProperties": false,
      "description": "Reference evidence provenance in an envelope without exposing raw content.",
      "properties": {
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hash",
          "type": "string"
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "evidence_id",
        "provider",
        "version",
        "hash"
      ],
      "title": "SourceRefV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/MarketPayloadV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContractError"
        },
        {
          "type": "null"
        }
      ]
    },
    "license_status": {
      "enum": [
        "approved",
        "restricted",
        "unknown",
        "revoked",
        "not_applicable"
      ],
      "title": "License Status",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "research-v1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "items": {
        "$ref": "#/$defs/SourceRefV1"
      },
      "maxItems": 20,
      "title": "Source",
      "type": "array"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "unavailable",
        "error"
      ],
      "title": "Status",
      "type": "string"
    },
    "warnings": {
      "items": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "status",
    "as_of",
    "data",
    "source",
    "license_status",
    "warnings",
    "error"
  ],
  "title": "ResearchEnvelope[MarketPayloadV1]",
  "type": "object"
}
